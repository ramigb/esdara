---
// Mark: an equalizer whose tallest bar, with the dot beneath it, reads as the alef-with-hamza of "إصدارة".
import { href, ui, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
---

<a class="logo" href={href(lang)} aria-label={ui[lang].site}>
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="8" fill="var(--accent)"></rect>
    <g fill="var(--accent-fg)">
      <rect x="19" y="5" width="5" height="16" rx="2.5"></rect>
      <rect x="12" y="11" width="5" height="10" rx="2.5"></rect>
      <rect x="5" y="15" width="5" height="6" rx="2.5"></rect>
      <circle cx="21.5" cy="26" r="2.5"></circle>
    </g>
  </svg>
  <span class="word">{ui.ar.site}</span>
  <span class="word latin">{ui.en.site}</span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--fg); text-decoration: none; }
  svg { width: 2.25rem; height: 2.25rem; flex: none; }
  .word { font-weight: 700; font-size: 1.375rem; line-height: 1; }
  .latin { font-weight: 400; font-size: 0.875rem; color: var(--muted); letter-spacing: 0.08em; text-transform: uppercase; }
</style>
