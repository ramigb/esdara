---
import { Image } from 'astro:assets';
import type { Release } from '../data';
import type { Lang } from '../i18n';

const { release, lang } = Astro.props as { release: Release; lang: Lang };
---

<div class="cover" style={`--hue: ${release.hue}`}>
  {
    release.cover ? (
      <Image src={release.cover} width={480} height={480} fit="cover" alt="" loading="lazy" />
    ) : (
      <span aria-hidden="true">{release.title[lang].charAt(0)}</span>
    )
  }
</div>

<style>
  .cover {
    aspect-ratio: 1;
    border-radius: var(--radius);
    overflow: hidden;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, hsl(var(--hue) 55% 42%), hsl(calc(var(--hue) + 40) 60% 22%));
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.12);
  }
  img { width: 100%; height: 100%; object-fit: cover; display: block; }
  span { font-size: 3.5rem; font-weight: 700; color: rgb(255 255 255 / 0.85); }
</style>
