---
import Base from '../../layouts/Base.astro';
import Feed from '../../components/Feed.astro';
import ReleaseCard from '../../components/ReleaseCard.astro';
import { facetValues, findReleases, loadReleases, paginate } from '../../data';
import { websiteLd } from '../../jsonld';
import { facetLabel, href, langPaths, toLang, ui } from '../../i18n';
import pickIds from '../../../content/picks.json';
import { contributeUrl } from '../../site';

export const getStaticPaths = langPaths;
const lang = toLang(Astro.params.lang);
const all = await loadReleases();
const pages = paginate(all);
const picks = findReleases(all, pickIds);
---

<Base lang={lang} path="/" jsonLd={websiteLd(Astro.site!, lang)}>
  <h1>{ui[lang].tagline}</h1>
  <p class="lead">{ui[lang].intro}</p>
  <p class="cta">
    <a href={contributeUrl}>{ui[lang].addMusic}</a>
    <a href={href(lang, '/search/')}>{ui[lang].search}</a>
  </p>
  <nav class="browse" aria-label={ui[lang].browse}>
    {
      (['genre', 'country'] as const).map((facet) => (
        <div>
          <span>{ui[lang][facet]}</span>
          {facetValues(all, facet).map((value) => (
            <a href={href(lang, `/${facet}/${value}/`)}>{facetLabel(lang, facet, value)}</a>
          ))}
        </div>
      ))
    }
  </nav>
  {
    picks.length > 0 && (
      <section class="picks" aria-labelledby="picks">
        <h2 id="picks">{ui[lang].picks}</h2>
        <div>{picks.map((r) => <ReleaseCard release={r} lang={lang} />)}</div>
      </section>
    )
  }
  <Feed lang={lang} all={all} releases={pages[0]} page={1} pages={pages.length} base="/" />
</Base>

<style>
  .cta { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-block: 1.25rem 0; }
  .cta a { padding: 0.55rem 1.1rem; border-radius: 999px; font-weight: 500; text-decoration: none; border: 1px solid var(--line); color: var(--fg); background: var(--surface); }
  .cta a:first-child { background: var(--accent); border-color: var(--accent); color: var(--accent-fg); }
  .browse { margin-block: 1.75rem 0; display: grid; gap: 0.6rem; }
  /* One row per facet; on narrow screens the row scrolls sideways instead of pushing the feed down. */
  .browse div { display: flex; align-items: center; gap: 0.4rem; overflow-x: auto; scrollbar-width: none; min-width: 0; }
  .browse span { flex: none; min-width: 4.5rem; font-size: 0.8125rem; color: var(--muted); }
  .browse a { flex: none; padding: 0.3rem 0.8rem; border-radius: 999px; font-size: 0.875rem; text-decoration: none; color: var(--fg); background: var(--line); }
  .browse a:hover, .browse a:focus-visible { background: var(--accent); color: var(--accent-fg); }
  @media (min-width: 40rem) { .browse div { flex-wrap: wrap; } }
  .picks { margin-block: 2rem 0; }
  .picks h2 { font-size: 1.25rem; margin: 0 0 1rem; }
  /* One row of covers that scrolls sideways, so a few picks don't push the latest releases far down. */
  .picks div { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(150px, 190px); gap: 1rem; overflow-x: auto; padding-block-start: 0.25rem; scrollbar-width: thin; }
</style>
