---
// Served by Cloudflare Pages with a real 404 status for any unknown URL (without this file it serves the home page
// with 200). One file for both languages, since the URL may be from either.
import Base from '../layouts/Base.astro';
---

<Base lang="ar" title="الصفحة غير موجودة" path="/" noindex>
  <h1>الصفحة غير موجودة</h1>
  <p class="lead">ربما نُقلت الصفحة أو أُزيلت. <a href="/">العودة إلى الصفحة الرئيسية</a></p>
  <h2 lang="en" dir="ltr">Page not found</h2>
  <p class="lead" lang="en" dir="ltr">It may have moved or been removed. <a href="/en/">Go to the home page</a></p>
</Base>
